# Keep this unset to use the backend currently built into the frontend.
# Set it to the HTTPS hostname of the local computer's tunnel to switch hosts.
VITE_BACKEND_URL=https://simulation.example.com

# Public PostHog project token (Project settings -> Web snippet).
# Use https://eu.i.posthog.com for EU Cloud or https://us.i.posthog.com for US Cloud.
VITE_POSTHOG_KEY=phc_your_public_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com
